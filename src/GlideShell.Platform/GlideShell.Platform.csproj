<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 实现层：Raw Input、DWM、DirectComposition、虚拟桌面 COM、注册表。只依赖 Core。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>GlideShell.Platform</RootNamespace>
    <!-- NativeAOT / 裁剪分析：警告即错误，保证随时能切到 NativeAOT 发布（需要 MSVC 链接器） -->
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlideShell.Core\GlideShell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GlideShell.Tests" />
  </ItemGroup>

</Project>
