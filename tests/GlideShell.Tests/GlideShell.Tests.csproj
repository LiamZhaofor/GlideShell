<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 要能测 Platform 里的纯函数部分（如 HID 单位换算），所以用 -windows TFM -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>GlideShell.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GlideShell.Core\GlideShell.Core.csproj" />
    <ProjectReference Include="..\..\src\GlideShell.Platform\GlideShell.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- 真机轨迹夹具（S1 录制后挑选放入），回放测试从输出目录读取 -->
    <None Include="Traces\**\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
